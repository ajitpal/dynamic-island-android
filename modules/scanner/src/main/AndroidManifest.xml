<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The camera, only while a scanner screen is open. Pictures are read on the phone and not kept. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- No internet permission. -->

    <!-- Apps that can open what you scanned: browsers, UPI apps, maps, mail, PDF viewers. -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="upi" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/pdf" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Island · Scanner"
        android:theme="@style/Theme.Module">

        <service
            android:name=".ScannerModule"
            android:exported="true"
            android:label="Scanner">
            <intent-filter>
                <action android:name="com.ajit.dynamicisland.action.MODULE" />
            </intent-filter>
            <meta-data android:name="com.ajit.dynamicisland.module.DESCRIPTION"
                android:value="Scan QR codes and barcodes from the island: open links, join Wi-Fi, pay with UPI, add contacts. Scan documents into a straightened PDF. Read on your phone, with no internet permission." />
            <meta-data android:name="com.ajit.dynamicisland.module.SETTINGS_ACTIVITY" android:value=".MainActivity" />
            <meta-data android:name="com.ajit.dynamicisland.module.DEVELOPER" android:value="Ajit Kumar Pal" />
        </service>

        <activity android:name=".MainActivity" android:exported="true" android:label="Scanner" android:launchMode="singleTop" />

        <!-- App-drawer entry on an alias, so the island can hide the icon (IslandContract.LAUNCHER_ALIAS). -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Opened by the island (tools, tile, buttons). Only the island and this app can open them. -->
        <activity android:name=".CodeActivity" android:exported="true" android:permission="com.ajit.dynamicisland.permission.HOST"
            android:screenOrientation="portrait" android:theme="@style/Theme.Module" android:excludeFromRecents="true" />
        <activity android:name=".DocActivity" android:exported="true" android:permission="com.ajit.dynamicisland.permission.HOST"
            android:screenOrientation="portrait" android:theme="@style/Theme.Module" />
        <activity android:name=".OpenActivity" android:exported="true" android:permission="com.ajit.dynamicisland.permission.HOST"
            android:excludeFromRecents="true" android:taskAffinity="" android:theme="@style/Theme.Module.Translucent" />
    </application>
</manifest>
