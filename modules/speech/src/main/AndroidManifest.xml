<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to download a speech model once; audio and text never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SpeechApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Island · Speech Pack"
        android:theme="@style/Theme.Module">

        <service android:name=".SpeechModule" android:exported="true" android:label="Speech Pack">
            <intent-filter>
                <action android:name="com.ajit.dynamicisland.action.MODULE" />
            </intent-filter>
            <meta-data android:name="com.ajit.dynamicisland.module.DESCRIPTION"
                android:value="Hindi and Hinglish speech-to-text on your phone for Meeting Notes, on phones whose Android has no offline Hindi. Uses Meta's Omnilingual ASR; audio and text never leave the phone." />
            <meta-data android:name="com.ajit.dynamicisland.module.DEVELOPER" android:value="Ajit Kumar Pal" />
        </service>

        <!-- Meeting Notes (and other first-party apps) bind here; callers are checked by signing key. -->
        <service android:name=".SpeechService" android:exported="true">
            <intent-filter>
                <action android:name="com.ajit.dynamicisland.action.SPEECH_ENGINE" />
            </intent-filter>
        </service>

        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />

        <activity android:name=".MainActivity" android:exported="true" android:label="Speech Pack" />
        <activity-alias android:name=".Launcher" android:targetActivity=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
