<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet lives here, never in the Dynamic Island app: only to read update.json and the signed module catalogue, and download APKs from GitHub. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Install the updates you confirm (Android shows its own prompt for each one). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the daily check scheduled after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- See the island and its modules to compare versions. -->
    <queries>
        <package android:name="com.ajit.dynamicisland" />
        <intent>
            <action android:name="com.ajit.dynamicisland.action.MODULE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Island · Updater"
        android:theme="@style/Theme.Module">

        <service
            android:name=".UpdaterModule"
            android:exported="true"
            android:label="Updater">
            <intent-filter>
                <action android:name="com.ajit.dynamicisland.action.MODULE" />
            </intent-filter>
            <meta-data android:name="com.ajit.dynamicisland.module.DESCRIPTION"
                android:value="Keeps Dynamic Island and its modules up to date from GitHub Releases. Checks once a day, tells you what's new, and installs only when you confirm. The island app itself stays offline." />
            <meta-data android:name="com.ajit.dynamicisland.module.DEVELOPER" android:value="Ajit Kumar Pal" />
        </service>

        <activity android:name=".MainActivity" android:exported="true" android:label="Software Update" />

        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".CheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".InstallResultReceiver" android:exported="false" />

        <!-- The signed module catalogue it downloaded, for the island's "Get more" list. Only the
             genuine island (HOST signature permission) can read it; the island verifies it again. -->
        <provider
            android:name=".CatalogProvider"
            android:authorities="com.ajit.dynamicisland.module.updater.catalog"
            android:exported="true"
            android:readPermission="com.ajit.dynamicisland.permission.HOST" />

        <!-- Only the genuine island (which holds its HOST signature permission) can turn checks on or off. -->
        <receiver
            android:name=".ModuleStateReceiver"
            android:exported="true"
            android:permission="com.ajit.dynamicisland.permission.HOST">
            <intent-filter>
                <action android:name="com.ajit.dynamicisland.action.MODULE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
